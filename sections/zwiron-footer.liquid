{%- liquid
  assign brand = section.settings.brand_name | default: 'zwiron'
  assign year = 'now' | date: '%Y'
-%}

<section class="zw zw-footer">
  <div class="zw-footer__inner">
    <div class="zw-footer__top">
      <div class="zw-footer__brand">
        <h3>{{ brand }}.</h3>
        <p>{{ section.settings.tagline | default: 'A contemporary label for considered objects. Drops twice yearly. Made deliberately, worn freely.' }}</p>
        <form action="#" method="post" style="margin-top: 28px; display:flex; gap: 8px; max-width: 380px;">
          <input type="email" placeholder="Get drop alerts" required style="flex:1; padding: 14px 18px; background: var(--zw-bg-elev); border: 1px solid var(--zw-line); color: var(--zw-fg); border-radius: 999px; font-family: inherit; font-size: 14px;">
          <button type="submit" class="zw-btn zw-btn--primary" style="padding: 14px 22px;">Join</button>
        </form>
      </div>

      <div class="zw-footer__col">
        <h4>Shop</h4>
        <ul>
          <li><a href="{{ routes.collections_url }}">All</a></li>
          <li><a href="{{ routes.collections_url }}">New arrivals</a></li>
          <li><a href="{{ routes.collections_url }}">Outerwear</a></li>
          <li><a href="{{ routes.collections_url }}">Accessories</a></li>
          <li><a href="{{ routes.collections_url }}">Archive</a></li>
        </ul>
      </div>

      <div class="zw-footer__col">
        <h4>Studio</h4>
        <ul>
          <li><a href="/pages/about">About</a></li>
          <li><a href="/pages/journal">Journal</a></li>
          <li><a href="/pages/lookbook">Lookbook</a></li>
          <li><a href="/pages/press">Press</a></li>
          <li><a href="/pages/stockists">Stockists</a></li>
        </ul>
      </div>

      <div class="zw-footer__col">
        <h4>Help</h4>
        <ul>
          <li><a href="/pages/contact">Contact</a></li>
          <li><a href="/pages/shipping">Shipping</a></li>
          <li><a href="/pages/returns">Returns</a></li>
          <li><a href="/policies/privacy-policy">Privacy</a></li>
          <li><a href="/policies/terms-of-service">Terms</a></li>
        </ul>
      </div>
    </div>

    <div class="zw-footer__bottom">
      <span>crafted by <a href="https://zahinafsar.com" target="_blank" rel="noopener" style="color: var(--zw-accent); text-decoration: none;">zahin afsar</a></span>
      <span style="display:flex; gap: 24px;">
        <a href="https://instagram.com" style="color:inherit; text-decoration:none;">Instagram</a>
        <a href="https://twitter.com" style="color:inherit; text-decoration:none;">X</a>
        <a href="https://tiktok.com" style="color:inherit; text-decoration:none;">TikTok</a>
        <a href="https://youtube.com" style="color:inherit; text-decoration:none;">YouTube</a>
      </span>
    </div>
  </div>
  <div class="zw-footer__big" aria-hidden="true">{{ brand }}</div>
</section>

{% schema %}
{
  "name": "Zwiron Footer",
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "zwiron" },
    { "type": "textarea", "id": "tagline", "label": "Tagline" }
  ],
  "presets": [{ "name": "Zwiron Footer" }]
}
{% endschema %}
