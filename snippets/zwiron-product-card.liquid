{% doc %}
  Renders a Zwiron-styled product card.
  @param {object} [product] - Shopify product object
  @param {string} [fallback_image] - Optional fallback image URL when no product image
  @param {string} [fallback_name] - Optional fallback display name
  @param {number} [fallback_price] - Optional fallback price (whole number) for placeholders
  @example
  {% render 'zwiron-product-card', product: product %}
{% enddoc %}

{%- liquid
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
  assign tag_label = ''
  if on_sale
    assign tag_label = 'Sale'
  elsif product.tags contains 'new'
    assign tag_label = 'New'
  elsif product.tags contains 'limited'
    assign tag_label = 'Limited'
  endif
  assign card_url = product.url | default: routes.collections_url
  assign card_name = product.title | default: fallback_name
  assign card_cat = product.type | default: product.vendor | default: 'Zwiron'
-%}

<article class="zw-product">
  <a href="{{ card_url }}" class="zw-product__media" aria-label="{{ card_name }}">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: card_name, widths: '320,480,640,800' }}
    {%- elsif fallback_image -%}
      <img src="{{ fallback_image }}" alt="{{ card_name }}" loading="lazy">
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
    {%- if tag_label != '' -%}
      <span class="zw-product__tag">{{ tag_label }}</span>
    {%- endif -%}
  </a>
  <div class="zw-product__body">
    <span class="zw-product__cat">{{ card_cat }}</span>
    <a class="zw-product__name" href="{{ card_url }}">{{ card_name }}</a>
    <div class="zw-product__price">
      <span>
        {%- if product -%}
          {{ product.price | money }}
          {%- if on_sale -%}<small class="zw-product__compare">{{ product.compare_at_price | money }}</small>{%- endif -%}
        {%- else -%}
          ${{ fallback_price | default: 195 }}
        {%- endif -%}
      </span>
      <a class="zw-product__cta" href="{{ card_url }}" aria-label="View {{ card_name }}">→</a>
    </div>
  </div>
</article>
